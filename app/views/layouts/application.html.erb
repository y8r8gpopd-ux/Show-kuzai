<!DOCTYPE html>
<html>
  <head>
    <title>ShowKuzai</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
   <header class="top-header">
      <div class="logo-box">
        <%= link_to image_tag('dummy.png', class: 'top-header-logo'), root_path %>
        <p>冷蔵庫から、今日のごはんを見つけよう</p>
      </div>
      <ul class="top-header-menu">
        <% if user_signed_in? %>
          <li><a href="#"> あなたの冷蔵庫 </a></li>
        <% else %>
          <li><%= link_to 'ログイン', new_user_session_path %></li>
          <li><%= link_to '新規登録',  new_user_registration_path %></li>
        <% end %>
        <li>メニュー検索</li>
        <li>おしらせ</li>
      </ul>
    </header>

    <%= yield %>
  </body>
</html>