<div class="ingredient-form">

  <%# 食材登録時のエラーメッセージ %>
  <% if flash[:alert] %>
    <div class="error-message">
      <%= flash[:alert] %>
    </div>
  <% end %>
  <%# 食材登録時のエラーメッセージ %>

  <%= form_with model: @ingredient, local: true do |f| %>
    <%= f.text_field :name, class: 'ingredient-area' %>
    <%= f.submit %>
  <% end %>

  <div class="ingredient-del">
    <%= link_to '食材削除', ingredient_path(@ingredient.id), data:{turbo_method: :delete}, class: 'ingredient-del-btn' %>
  </div>
  
</div>
