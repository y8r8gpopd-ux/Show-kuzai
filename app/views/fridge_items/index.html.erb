<div class="main"> 
  <section class="recipe-section">
    <% if user_signed_in? %>
      <h2 class="recipe-title">あなたにおすすめのレシピ</h2>
    <% else %>
      <h2 class="recipe-title">おすすめのレシピ</h2>
    <% end %>

    <div class="recipe-area">
      <% if @recipes.present? %>
        <% @recipes.each do |recipe| %>
          <div class="recipe-card">
            <% if recipe.image.attached? %>
              <%= link_to image_tag(recipe.image), recipe_path(recipe.id) %>
            <% else %>
              <%= image_tag 'dummy.png' %>
            <% end %>
            <div class="recipe-body">
              <h3><%= recipe.name %></h3>
              <% if user_signed_in? %>
                <% matched_ingredients = recipe.ingredients.select do |ingredient| %>
                  <% @fridge_ingredient_ids.include?(ingredient.id) %>
                <% end %>

                <% if matched_ingredients.any? %>
                  <p>冷蔵庫の
                    <% matched_ingredients.each do |ingredient| %>
                      「<%= ingredient.name %>」
                    <% end %>
                  が使えます！</p>
                <% end %>
            
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
    <p>おすすめ順</p>
  </section>

  <!-- 食材登録フォーム -->
  <% if user_signed_in? %>
   <section class="fridge-section">
      <h2>食材を登録</h2>

      <div class="ingredient-form">
        <%= form_with model: @fridge_item, local: true do |f| %>

          <%= text_field_tag :keyword, nil, placeholder: "食材名検索", id: "ingredient-search" %>
          <div id="search-result"></div>
          <%= hidden_field_tag "fridge_item[ingredient_id]", nil, id: "selected-ingredient-id" %>

          <%#= f.number_field :quantity %>
          <%#= f.collection_select(:unit_id, Unit.all, :id, :name,{}) %>
          <div id="selected-ingredients"><span>登録する食材</span></div>
          <%= f.submit '冷蔵庫に追加する' , class: 'register-fridge-item' %>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @cooking_histories.present? %>
    <!-- 料理履歴 -->
    <section class="history-section">
      <h2>最近作った料理</h2>

      <% @cooking_histories.each do |history| %>

        <%= link_to recipe_path(history.recipe_id) do %>
          <div class="history-card">
            <p><%= history.recipe.name %></p>
            <span><%= l history.created_at %></span>
          </div>
        <% end %>
      <% end %>
    </section>
  <% end %>

  <% if user_signed_in? && current_user.admin? %>

    <%= link_to '食材登録', new_ingredient_path %>
    <br>
    <%= link_to '登録食材一覧', ingredients_path %>
    <br>
    <%= link_to 'レシピ投稿', new_recipe_path %>
  <% end %>
  
</div>