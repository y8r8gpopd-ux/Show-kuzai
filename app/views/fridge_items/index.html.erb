<div class="main"> 
  <section class="recipe-section">
    <h2 class="recipe-title">あなたにおすすめのレシピ</h2>

    <div class="recipe-area">
      <% @recipes.each do |recipe| %>
        <div class="recipe-card">
        <% if recipe.image.attached? %>
          <%= link_to image_tag(recipe.image), recipe_path(recipe.id) %>
        <% else %>
          <%= image_tag 'dummy.png' %>
        <% end %>
          <div class="recipe-body">
            <h3><%= recipe.name %></h3>
            <p>冷蔵庫の「卵」「鶏肉」を使えます！</p>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <!-- 食材登録フォーム -->
  <section class="fridge-section">
    <h2>食材を登録</h2>

    <div class="ingredient-form">
      <%= form_with model: @fridge_item, local: true do |f| %>
        <%= f.collection_select(:ingredient_id, Ingredient.all, :id, :name,{prompt: "---"})  %>
        <%= f.number_field :quantity %>
        <%= f.collection_select(:unit_id, Unit.all, :id, :name,{}) %>
        <%= f.submit '冷蔵庫に追加する' %>
      <% end %>
    </div>
  </section>

  <!-- 料理履歴 -->
  <section class="history-section">
    <h2>最近作った料理</h2>

    <div class="history-card">
      <p>🍳 カレーライス</p>
      <span>2026/05/08</span>
    </div>

    <div class="history-card">
      <p>🥗 野菜炒め</p>
      <span>2026/05/06</span>
    </div>
  </section>

  <%= link_to '食材登録', new_ingredient_path %>
  <br>
  <%= link_to '登録食材一覧', ingredients_path %>
  <br>
  <%= link_to 'レシピ投稿', new_recipe_path %>
  
</div>