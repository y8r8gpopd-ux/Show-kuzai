<% if flash[:alert] %>
  <div class="error-message">
    <%= flash[:alert] %>
  </div>
<% end %>

<div class="recipe-form-card">
  <%= form_with model: recipe do |f| %>
    <%= f.text_field :name %>
    <%= f.collection_select(:genre_id, Genre.all, :id, :name, {}) %>
    <%= f.file_field :image %>

    <%# 食材カードは部分テンプレートで描画する %>
    <div id="ingredient-forms">
      <%= f.fields_for :recipe_ingredients do |ri| %>
        <%= render "ingredient_fields", f: ri %>
      <% end %>
    </div>

    <%# JS複製用template %>
    <template id="ingredient-template">
      <%= f.fields_for :recipe_ingredients,RecipeIngredient.new,child_index: "INDEX" do |ri| %>
        <%= render "ingredient_fields", f: ri %>
      <% end %>
    </template>

    <button type="button" id="add-ingredient">
      ＋ 食材追加
    </button>
    <%= f.text_area :how_to_cook %>
    <%= f.submit %>

  <% end %>
</div>
