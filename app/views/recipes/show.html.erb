<div class="show-main">

  <!-- レシピタイトル -->
  <div class="recipe-show-header">
    <h1 class="recipe-show-title">
      <%= @recipe.name %>
    </h1>

    <div class="recipe-show-genre">
      <%= @recipe.genre.name %>
    </div>
  </div>

  <!-- 画像 + 材料 -->
  <div class="recipe-show-content">

    <!-- 画像 -->
    <div class="recipe-show-image-area">
    <% if @recipe.image.attached? %>
      <%= image_tag @recipe.image, class: "recipe-show-image" %>
    <% else %>
      <%= image_tag 'dummy.png', class: "recipe-show-image" %>
    <% end %>
    </div>

    <!-- 材料 -->
    <div class="recipe-show-ingredients">
      <h2>材料</h2>

      <ul class="ingredient-list">
        <% @recipe.recipe_ingredients.each do |ingredient| %>
          <li>
            <span class="ingredient-name">
              <%= ingredient.ingredient.name %>
            </span>

            <span class="ingredient-quantity">
              <%= ingredient.quantity %>
              <%= ingredient.unit.name %>
            </span>
          </li>
        <% end %>
      </ul>
    </div>

  </div>

  <!-- 作り方 -->
  <div class="recipe-how-to">
    <h2>作り方</h2>

    <div class="how-to-body">
      <%= simple_format(@recipe.how_to_cook) %>
    </div>
  </div>

  <% if user_signed_in? %>
    <%= button_to "調理完了！",cook_recipe_path(@recipe),method: :patch , class: "cooked-btn" %>
  <% end %>

  <% if user_signed_in? && current_user.admin? %>
    <%= link_to "レシピ編集",edit_recipe_path(@recipe.id), class: "admin-btn" %>
    <%= link_to "レシピ削除",recipe_path(@recipe), data: {turbo_method: :delete}, class: "admin-btn" %>
  <% end %>
</div>