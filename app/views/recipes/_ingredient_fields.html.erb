<div class="ingredient-card" data-index="INDEX">
  <%= f.hidden_field :id %>
  <%= f.hidden_field :_destroy, value: 0 %>
  <%= f.collection_select(:ingredient_id, Ingredient.all, :id, :name,{prompt: "---"}) %>
  <%= f.number_field :quantity %>
  <%= f.collection_select(:unit_id, Unit.all, :id, :name, {}, { class: "unit-select" }) %>
  <button type="button" class="delete-btn">
    ×
  </button>
</div>
